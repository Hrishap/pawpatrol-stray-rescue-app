# Copy this file to .env and fill in real values. Never commit .env.
# For local development these come from `supabase status` after `supabase start`.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Set once `eas init` has created a project for this app.
EAS_PROJECT_ID=

# No Mapbox/Google Maps key needed — maps use a WebView + Leaflet +
# OpenStreetMap tiles (src/components/LeafletMap.tsx), which is free and
# account-free.
