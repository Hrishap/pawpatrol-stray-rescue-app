# Copy this file to .env and fill in real values. Never commit .env.
# For local development these come from `supabase status` after `supabase start`.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Public Mapbox access token (starts with "pk.") — from your Mapbox account's
# Tokens page: https://account.mapbox.com/access-tokens/
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=

# Secret Mapbox *download* token (starts with "sk.", needs the "Downloads:Read"
# scope) — used only at native-build time to fetch the Mapbox SDK, never
# shipped in the app. From the same Mapbox tokens page, "Create a token" with
# that scope checked.
MAPBOX_DOWNLOAD_TOKEN=

# Set once `eas init` has created a project for this app.
EAS_PROJECT_ID=
